#!/bin/sh
# Runs on `snap set/unset lienka ...`: rewrites $SNAP_DATA/lienka.conf from the
# snap config. The daemon picks values up on restart (hooks can't self-restart).
set -e

conf="$SNAP_DATA/lienka.conf"
tmp="$conf.tmp"
: > "$tmp"

put() { # $1 = snap set key, $2 = env var in the launcher
    val=$(snapctl get "$1" || true)
    [ -n "$val" ] && printf '%s="%s"\n' "$2" "$val" >> "$tmp"
}

put port PORT
put host HOST
put http-port HTTP_PORT
put users USERS
put birth-date BIRTH_DATE
put tz TZ

mv "$tmp" "$conf"
